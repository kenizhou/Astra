{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astra Mail",
  "identifier": "com.kenizhou.astra",
  "build": {
    "beforeDevCommand": {
      "script": "node client/desktop/scripts/stage-cli.mjs --placeholder-ok && npm --prefix sidecar run build",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "node client/desktop/scripts/stage-cli.mjs --placeholder-ok && cargo build --release --bin astra-cli && node client/desktop/scripts/stage-cli.mjs && npm --prefix sidecar ci && npm --prefix sidecar run build",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astra Mail",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; frame-src astra-plugin:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/astra-cli"
    ],
    "resources": {
      "../../sidecar/dist/": "sidecar/"
    },
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "mailto",
          "com.kenizhou.astra"
        ]
      }
    }
  }
}
